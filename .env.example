# Copy this file to .env and add your own key.
# Never commit .env or expose this key in browser code.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BILLING_TIER=free
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_OUTPUT_TOKENS=8192

# Backoff controls for HTTP 429 / 503 responses.
RETRY_BASE_SECONDS=1
RETRY_MAX_SECONDS=30

# Application
APP_ENV=development
